{
	"name": "cualli/link-monitor",
	"description": "Weekly scan of internal links, images, CSS and JS for cualli.mx, with an email report after every scan.",
	"type": "wordpress-muplugin",
	"license": "proprietary",
	"require": {
		"php": ">=8.2"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"Cualli\\LinkMonitor\\": "cualli-link-monitor/src/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	}
}
